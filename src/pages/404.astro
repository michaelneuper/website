---
import Base from "../layouts/Base.astro";
---
<Base title="Not found - Michael Neuper" buf="*Messages*" mode="Messages" skip="#missing">
  <Fragment slot="head">
    <script src="../scripts/page.js"></script>
  </Fragment>

  <main>
    <section class="sec" id="missing" data-file="*Messages*" data-mode="Messages" aria-labelledby="missing-title">
      <p class="winbar"><span class="file">*Messages*</span><span class="rule" aria-hidden="true"></span><span class="meta">404</span></p>
      <h1 class="h2" id="missing-title">No such file</h1>
      <p class="lede">Nothing lives at this address. If it was a page on my old site, it didn't make the move, but every post did, at the same address as before.</p>
      <p class="missing-links"><a href="/">Home</a> <a href="/#posts">Posts</a></p>
    </section>
    <footer class="foot">
      <p class="dim">Press <kbd>SPC</kbd> for commands or <kbd>M-x</kbd> to run one by name.</p>
    </footer>
  </main>
</Base>
