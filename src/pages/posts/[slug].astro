---
// One post, shown as its Markdown buffer: front matter, then the text, with an
// imenu-list window of its headings beside it when the post asks for a table of
// contents, and the giscus comments from the old site below.
import { render } from "astro:content";
import "katex/dist/katex.min.css";
import Base from "../../layouts/Base.astro";
import { publishedPosts, summary, wordCount, weekday, ymd } from "../../lib/posts.js";
import { TAG_COLORS } from "../../scripts/tags.js";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, tags, toc } = post.data;
const file = `${post.id}.md`;
const words = wordCount(post.body ?? "");
const minutes = Math.max(1, Math.round(words / 230));
// (the footnotes' heading is only there for screen readers)
const outline = toc ? headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== "footnote-label") : [];
---
<Base title={`${title} - Michael Neuper`} description={summary(post.body ?? "")} buf={file} mode="Markdown" skip="#post">
  <Fragment slot="head">
    <script src="../../scripts/page.js"></script>
  </Fragment>
  <Fragment slot="help">
    <div><dt><code>imenu</code></dt><dd>jump to a heading in this post</dd></div>
    <div><dt><kbd>SPC n</kbd></dt><dd>back to the list of posts</dd></div>
  </Fragment>

  <main>
    <section class="sec post" id="post" data-file={file} data-mode="Markdown" aria-labelledby="post-title">
      <p class="winbar"><span class="file">{file}</span><span class="rule" aria-hidden="true"></span><span class="meta">{words.toLocaleString("en")} words, {minutes} min</span></p>

      <div class="fm">
        <p class="fm-fence" aria-hidden="true">---</p>
        <p><span class="fm-k">date:</span> <time class="fm-ts" datetime={ymd(date)}>{ymd(date)} {weekday(date)}</time></p>
        {tags.length > 0 && (
          <p><span class="fm-k">tags:</span> [{tags.map((t, i) => (
            <Fragment>{i > 0 && ", "}<span class="t" style={`--tag: ${TAG_COLORS[t] ?? "var(--dim)"}`}>{t}</span></Fragment>
          ))}]</p>
        )}
        <p class="fm-fence" aria-hidden="true">---</p>
      </div>

      <h1 class="post-title" id="post-title">{title}</h1>

      <div class:list={["post-cols", { "has-toc": outline.length > 0 }]}>
        {outline.length > 0 && (
          <aside class="post-toc" aria-labelledby="toc-title">
            <p class="winbar"><span class="file" id="toc-title">*Ilist*</span><span class="rule" aria-hidden="true"></span><span class="meta">contents</span></p>
            <ol>
              {outline.map((h) => (
                <li class={`d${h.depth}`}><a href={`#${h.slug}`}><span class="mk" aria-hidden="true">{"#".repeat(h.depth)}</span> {h.text}</a></li>
              ))}
            </ol>
          </aside>
        )}
        <article class="post-body">
          <Content />
        </article>
      </div>

      <nav class="post-nav" aria-label="More posts">
        {older ? <a class="older" href={`/posts/${older.id}/`}><span class="dim">older</span>{older.data.title}</a> : <span></span>}
        {newer && <a class="newer" href={`/posts/${newer.id}/`}><span class="dim">newer</span>{newer.data.title}</a>}
      </nav>
      <p class="post-all"><a href="/#posts">All posts</a></p>
    </section>

    <section class="sec post-comments" id="comments" data-file="*comments*" data-mode="giscus" aria-labelledby="comments-title">
      <p class="winbar"><span class="file" id="comments-title">*comments*</span><span class="rule" aria-hidden="true"></span><span class="meta">GitHub Discussions</span></p>
      <div class="giscus"></div>
      <p class="dim giscus-note">Comments load from GitHub Discussions through giscus.<noscript> They need JavaScript.</noscript></p>
    </section>

    <footer class="foot">
      <p class="dim">Press <kbd>SPC</kbd> for commands or <kbd>M-x</kbd> to run one by name.</p>
    </footer>
  </main>
</Base>
