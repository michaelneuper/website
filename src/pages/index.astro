<!doctype html>
<html lang="en" data-theme="doom-gruvbox">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Michael Neuper</title>
<meta name="description" content="Computer science student at Stellenbosch University. Low-level software, electronics, a little security, and a lot of Emacs.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/jetbrains-mono-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/cm-regular.woff2" as="font" type="font/woff2" crossorigin>
{/* is:inline: Astro ships this script as written instead of bundling it, so it still runs before first paint. */}
<script is:inline>
  // Pick the theme before first paint so there is no flash. Keep this list in sync with src/scripts/themes.js.
  try {
    var t = localStorage.getItem("theme");
    var known = /^(doom-gruvbox|doom-gruvbox-light|doom-one|atom-one-dark|modus-vivendi|modus-operandi|doom-dracula|doom-nord|catppuccin|doom-tokyo-night|doom-solarized-light)$/;
    if (!known.test(t || "")) t = matchMedia("(prefers-color-scheme: light)").matches ? "doom-gruvbox-light" : "";
    if (t) document.documentElement.dataset.theme = t;
  } catch (e) {}
  // Hide the name until src/scripts/decode.js has split it into letters, so it never flashes whole first.
  // CSS shows it anyway after a moment in case the script never runs.
  try {
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && (!location.hash || location.hash === "#top")) {
      document.documentElement.classList.add("boot");
    }
  } catch (e) {}
</script>
<script src="../scripts/main.js"></script>
</head>
<!-- Reading the source? Good instinct. flag{view_source_is_recon} -->
