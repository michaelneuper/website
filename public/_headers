# Response headers, read by both Netlify and Cloudflare.

/*
  X-Content-Type-Options: nosniff

# Astro puts a content hash in these file names, so browsers can keep them for good.
# The fonts are here too, and the comments' frame on giscus.app loads them.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://giscus.app

# The comments' frame on giscus.app loads its stylesheet from here.
# The stylesheets are open to any origin, so `npm run dev` can use them too.
/giscus/*
  Access-Control-Allow-Origin: *
